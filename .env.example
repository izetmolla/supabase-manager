# Copy to .env at the repo root and adjust. Real environment variables take precedence over this file.
# `make dev`, `make run-manager` and `./bin/supabase-manager` all run from the repo root, so relative paths resolve here.

# Address the manager listens on. Keep 127.0.0.1 and use an SSH tunnel or a reverse proxy with TLS.
ADDR=127.0.0.1:8080

# Manager database: sqlite (default) or postgres
DB_DRIVER=sqlite
DB_DSN=data/manager.db
# DB_DRIVER=postgres
# DB_DSN=postgres://manager:password@127.0.0.1:5432/supabase_manager?sslmode=disable

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Encrypts stored project secrets. Changing it makes existing secrets unreadable.
ENCRYPTION_KEY=change-me-too

# Where new projects are created
PROJECTS_ROOT=/root/supabase-projects

# Supabase CLI binary and Docker socket
SUPABASE_BIN=supabase
DOCKER_SOCKET=/var/run/docker.sock

# CLI releases installed from System settings go here; the latest is installed on startup if no CLI is found
TOOLS_DIR=data/bin
SUPABASE_AUTO_INSTALL=true

# Port allocation: project n gets PORT_RANGE_START + n*PORT_BLOCK (+21 api, +22 db, +23 studio, ...)
PORT_RANGE_START=54300
PORT_BLOCK=100
INSPECTOR_PORT_START=8083

# Set to true when served over HTTPS
SECURE_COOKIES=false

# Proxy Manager (enable it in System settings). Agents in the proxy containers connect to this gRPC
# address; a non-loopback address turns on TLS with a self-signed certificate the agents pin.
# PROXY_AGENT_ADDR=127.0.0.1:7070
# Proxy images: <repository>-nginx / <repository>-traefik, tagged with the manager's version.
# PROXY_IMAGE_REPOSITORY=izetmolla/supabase-manager-proxy
# PROXY_IMAGE_TAG=
