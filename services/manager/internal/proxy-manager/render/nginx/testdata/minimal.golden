==> nginx.conf <==
# Generated by Supabase Manager for instance "empty". Changes are overwritten on deploy.
worker_processes auto;
pid /var/run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    server_names_hash_bucket_size 128;
    client_max_body_size 16m;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;

    log_format sm_json escape=json '{"time":"$time_iso8601","host":"$host","remote":"$remote_addr","method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,"duration":$request_time,"upstream":"$upstream_addr","upstream_status":"$upstream_status","referer":"$http_referer","ua":"$http_user_agent"}';
    access_log off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SMSSL:10m;
    ssl_session_timeout 1d;

    include upstreams.conf;
    include hosts/*.conf;

    server {
        listen 8081 default_server;
        server_name _;
        location ^~ /.well-known/acme-challenge/ {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $host;
        }
        location / {
            return 404;
        }
    }
}

stream {
    include streams.conf;
}
