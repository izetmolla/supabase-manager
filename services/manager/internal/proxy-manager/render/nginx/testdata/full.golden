==> nginx.conf <==
# Generated by Supabase Manager for instance "edge". Changes are overwritten on deploy.
worker_processes auto;
pid /var/run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    server_names_hash_bucket_size 128;
    client_max_body_size 16m;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;

    log_format sm_json escape=json '{"time":"$time_iso8601","host":"$host","remote":"$remote_addr","method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,"duration":$request_time,"upstream":"$upstream_addr","upstream_status":"$upstream_status","referer":"$http_referer","ua":"$http_user_agent"}';
    access_log off;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SMSSL:10m;
    ssl_session_timeout 1d;

    include upstreams.conf;
    include hosts/*.conf;

    server {
        listen 10.0.0.5:80 default_server;
        server_name _;
        location ^~ /.well-known/acme-challenge/ {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $host;
        }
        location / {
            return 404;
        }
    }

    server {
        listen 10.0.0.5:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }
}

stream {
    include streams.conf;
}
==> streams.conf <==
# TCP/UDP streams (generated)

upstream sm_s3 {
    hash $remote_addr consistent;
    server 10.0.2.1:5432;
}

server {
    listen 10.0.0.5:5433;
    proxy_pass sm_s3;
    proxy_connect_timeout 10s;
    proxy_timeout 1h;
}

upstream sm_s2 {
    server api.internal:8443;
}

server {
    listen 10.0.0.5:5353 udp;
    proxy_pass sm_s2;
    proxy_timeout 30s;
}

==> upstreams.conf <==
# Upstreams (generated)

upstream sm_u1 {
    ip_hash;
    server 10.0.1.1:3000 weight=3 max_fails=3 fail_timeout=10s;
    server 10.0.1.2:3000 max_fails=3 fail_timeout=10s;
    server 10.0.1.3:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream sm_u2 {
    server api.internal:8443;
    keepalive 32;
}

==> warnings <==
upstream "app": nginx has no cookie stickiness, ip_hash is used instead
upstream "app": nginx cannot combine backup targets with IP hashing, 10.0.1.3:3000 is used as a regular target
